+static uint32_t chain_notes(const track_t *t, uint32_t idx, uint8_t *out)
+{
+    uint32_t len = t->p[P_SLEN] > 0 ? (uint32_t)t->p[P_SLEN] : 1u, k;
+    for (k = 1; k < len; k++) {
+        const step_t *s = &t->step[(idx + len - k) % len];
+        if (s->time == ST_TIE)
+            continue;
+        if (s->time == ST_NOTE && s->n && s->n <= 4u) {
+            memcpy(out, s->note, s->n);
+            return s->n;
+        }
+        return 0;
+    }
+    return 0;
+}
